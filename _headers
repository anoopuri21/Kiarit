# ==========================================================================
# KIARIT PHARMACEUTICALS — response headers (Cloudflare Workers static assets)
#
# This replaces the mod_headers / mod_expires blocks in .htaccess, which
# Cloudflare does not read. Rules are matched top to bottom; later matches
# add to earlier ones.
# ==========================================================================

# ---- Applies to every response ----
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content Security Policy.
  #   'unsafe-inline' on script-src is required by the 50 inline
  #     <script type="application/ld+json"> structured-data blocks.
  #   'unsafe-inline' on style-src is required by the 37 inline style=""
  #     attributes used for reveal delays and grid spans.
  #   frame-src allows the OpenStreetMap embed on the contact page.
  #   No external script or font origins are permitted: the site self-hosts
  #     everything and makes no third-party requests.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://www.openstreetmap.org; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests

# ---- Fingerprint-free static assets ----
# These filenames never change, so a long cache is safe. If you ever replace
# an image or stylesheet in place, purge the Cloudflare cache afterwards.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---- HTML ----
# Short cache so content edits go live quickly, with revalidation.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ---- Crawler and PWA files ----
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/site.webmanifest
  Cache-Control: public, max-age=86400
